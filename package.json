{
  "name": "prism-outpost",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Outpost: a mini RTS sandbox (Phase 1). Static site, Phaser + PathFinding.js from CDN.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "playwright test",
    "serve": "npx http-server -p 8080 -c-1 .",
    "test:fairness": "node --test \"test/fairness/*.test.js\"",
    "balance": "node tools/balance.mjs",
    "test:mobile": "MOBILE_PLAYTHROUGH=1 playwright test e2e/mobile-playthrough.spec.js",
    "test:rules": "firebase emulators:exec --project demo-dragonmarch --only auth,database \"node --test test/rules/*.test.js\"",
    "test:mp": "firebase emulators:exec --project demo-dragonmarch --only auth,database \"MULTIPLAYER=1 playwright test e2e/mp-\""
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.0",
    "pathfinding": "0.4.18",
    "phaser": "3.80.1"
  },
  "license": "MIT"
}
